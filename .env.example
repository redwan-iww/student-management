# Credentials for the live dev proxy (vite-zoho-proxy.ts).
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# Create these in the Zoho API console for the demo3 org:
#   https://api-console.zoho.<dc>  ->  Self Client  (or Server-based Application)
#
# Scopes needed by the two widgets:
#   ZohoCRM.modules.ALL,ZohoCRM.settings.modules.READ
#
# Leave any of the three blank and live mode stays off -- the widgets then have
# no data source at all and say so on screen.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre: com | in | eu | au | jp | ca
# demo3 is `com`. This said `in` until 2026-09-26, inferred from MCP endpoints
# that turned out to belong to a different account -- see docs/live-dev.md.
ZOHO_DC=com
