# Credentials for the live dev proxy (vite-zoho-proxy.ts).
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real values.
#
# Create these in the Zoho API console for the demo3 org:
#   https://api-console.zoho.<dc>  ->  Self Client  (or Server-based Application)
#
# Scopes needed by the two widgets:
#   ZohoCRM.modules.ALL,ZohoCRM.settings.modules.READ
#
# Leave any of the three blank and the dev server falls back to the mock.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre: com | in | eu | au | jp | ca
# demo3 is very likely `in` -- its MCP endpoints are *.zohomcp.in
ZOHO_DC=in
