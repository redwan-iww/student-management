{
  "_entity": "attendance",
  "module": "Attendance",
  "strategy": "create",
  "_comment": "Send `scalar_fields` first (ZohoCRM_createFields), then `lookup_fields` once every target module exists. Stock fields already present in Zoho are omitted.",
  "scalar_fields": [
    {
      "field_label": "Attendance No",
      "api_name": "Attendance_No",
      "data_type": "autonumber",
      "auto_number": {
        "prefix": "ATT-",
        "start_number": "1",
        "suffix": ""
      },
      "_entity_field": "attendance_no"
    },
    {
      "field_label": "Attendance",
      "api_name": "Status",
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Present",
          "actual_value": "Present",
          "sequence_number": 1
        },
        {
          "display_value": "Absent",
          "actual_value": "Absent",
          "sequence_number": 2
        },
        {
          "display_value": "Late",
          "actual_value": "Late",
          "sequence_number": 3
        },
        {
          "display_value": "Excused",
          "actual_value": "Excused",
          "sequence_number": 4
        }
      ],
      "system_mandatory": true,
      "default_value": "Present",
      "_entity_field": "status"
    },
    {
      "field_label": "Minutes Late",
      "api_name": "Minutes_Late",
      "data_type": "integer",
      "length": 9,
      "default_value": "0",
      "_entity_field": "minutes_late"
    },
    {
      "field_label": "Left Early",
      "api_name": "Left_Early",
      "tooltip": {
        "name": "info_icon",
        "value": "The student attended but did not stay to the end. A fact about the mark rather than a status of its own, so it can be true alongside Present and alongside a minutes_late above zero -- neither of which was expressible while leaving early was one of the sta"
      },
      "data_type": "boolean",
      "default_value": "false",
      "_entity_field": "left_early"
    },
    {
      "field_label": "Marked At",
      "api_name": "Marked_At",
      "data_type": "datetime",
      "_entity_field": "marked_at"
    },
    {
      "field_label": "Remarks",
      "api_name": "Remarks",
      "data_type": "textarea",
      "textarea": {
        "type": "small"
      },
      "_entity_field": "remarks"
    }
  ],
  "lookup_fields": [
    {
      "field_label": "Class Session",
      "api_name": "Class_Session",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Class_Sessions"
        },
        "display_label": "Attendance"
      },
      "system_mandatory": true,
      "_entity_field": "class_session"
    },
    {
      "field_label": "Admission",
      "api_name": "Admission",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Admissions"
        },
        "display_label": "Attendance"
      },
      "system_mandatory": true,
      "_entity_field": "admission"
    },
    {
      "field_label": "Student",
      "api_name": "Student",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Students"
        },
        "display_label": "Attendance"
      },
      "system_mandatory": true,
      "_entity_field": "student"
    },
    {
      "field_label": "Class",
      "api_name": "Class",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Classes"
        },
        "display_label": "Attendance"
      },
      "system_mandatory": true,
      "_entity_field": "class"
    },
    {
      "field_label": "Marked By",
      "api_name": "Marked_By",
      "tooltip": {
        "name": "info_icon",
        "value": "The teacher who took the class and recorded the mark."
      },
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Teachers"
        },
        "display_label": "Attendance"
      },
      "_entity_field": "marked_by"
    }
  ],
  "relabel_stock_fields": []
}
