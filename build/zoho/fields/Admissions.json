{
  "_entity": "admissions",
  "module": "Admissions",
  "strategy": "create",
  "_comment": "Send `scalar_fields` first (ZohoCRM_createFields), then `lookup_fields` once every target module exists. Stock fields already present in Zoho are omitted.",
  "scalar_fields": [
    {
      "field_label": "Application No",
      "api_name": "Application_No",
      "data_type": "autonumber",
      "auto_number": {
        "prefix": "APP-",
        "start_number": "1",
        "suffix": ""
      },
      "_entity_field": "application_no"
    },
    {
      "field_label": "Source",
      "api_name": "Source",
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Walk In",
          "actual_value": "Walk In",
          "sequence_number": 1
        },
        {
          "display_value": "Website",
          "actual_value": "Website",
          "sequence_number": 2
        },
        {
          "display_value": "Referral",
          "actual_value": "Referral",
          "sequence_number": 3
        },
        {
          "display_value": "Social Media",
          "actual_value": "Social Media",
          "sequence_number": 4
        },
        {
          "display_value": "Agent",
          "actual_value": "Agent",
          "sequence_number": 5
        },
        {
          "display_value": "Event",
          "actual_value": "Event",
          "sequence_number": 6
        },
        {
          "display_value": "Other",
          "actual_value": "Other",
          "sequence_number": 7
        }
      ],
      "_entity_field": "source"
    },
    {
      "field_label": "Stage",
      "api_name": "Stage",
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Admitted",
          "actual_value": "Admitted",
          "sequence_number": 1
        },
        {
          "display_value": "Placed",
          "actual_value": "Placed",
          "sequence_number": 2
        },
        {
          "display_value": "Completed",
          "actual_value": "Completed",
          "sequence_number": 3
        },
        {
          "display_value": "Dropped",
          "actual_value": "Dropped",
          "sequence_number": 4
        },
        {
          "display_value": "Withdrawn",
          "actual_value": "Withdrawn",
          "sequence_number": 5
        }
      ],
      "system_mandatory": true,
      "default_value": "Admitted",
      "_entity_field": "stage"
    },
    {
      "field_label": "Admitted On",
      "api_name": "Applied_Date",
      "data_type": "date",
      "system_mandatory": true,
      "_entity_field": "applied_date"
    },
    {
      "field_label": "Placed On",
      "api_name": "Placed_On",
      "data_type": "date",
      "_entity_field": "placed_on"
    },
    {
      "field_label": "Dropped On",
      "api_name": "Dropped_On",
      "data_type": "date",
      "_entity_field": "dropped_on"
    },
    {
      "field_label": "Drop Reason",
      "api_name": "Drop_Reason",
      "data_type": "textarea",
      "textarea": {
        "type": "small"
      },
      "_entity_field": "drop_reason"
    },
    {
      "field_label": "Final Grade",
      "api_name": "Final_Grade",
      "data_type": "text",
      "length": 10,
      "_entity_field": "final_grade"
    },
    {
      "field_label": "Admission Notes",
      "api_name": "Admission_Notes",
      "tooltip": {
        "name": "info_icon",
        "value": "api_name is not 'Notes' -- Zoho reserves that keyword."
      },
      "data_type": "textarea",
      "textarea": {
        "type": "small"
      },
      "_entity_field": "notes"
    }
  ],
  "lookup_fields": [
    {
      "field_label": "Student",
      "api_name": "Student",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Students"
        },
        "display_label": "Admissions"
      },
      "system_mandatory": true,
      "_entity_field": "student"
    },
    {
      "field_label": "Course",
      "api_name": "Course",
      "tooltip": {
        "name": "info_icon",
        "value": "The subject admitted to. Chosen at sign-up; a class running it comes later."
      },
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Course_Catalog"
        },
        "display_label": "Admissions"
      },
      "system_mandatory": true,
      "_entity_field": "course"
    },
    {
      "field_label": "Term",
      "api_name": "Term",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Terms"
        },
        "display_label": "Admissions"
      },
      "system_mandatory": true,
      "_entity_field": "term"
    },
    {
      "field_label": "Class",
      "api_name": "Class",
      "tooltip": {
        "name": "info_icon",
        "value": "Which run of the course they were put in. Empty until placed, which is what the enrolment board does -- an admitted-but-unplaced row is exactly what its left panel lists."
      },
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Classes"
        },
        "display_label": "Admissions"
      },
      "_entity_field": "class"
    }
  ],
  "relabel_stock_fields": []
}
