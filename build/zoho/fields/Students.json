{
  "_entity": "students",
  "module": "Students",
  "strategy": "extend_custom",
  "_comment": "Send `scalar_fields` first (ZohoCRM_createFields), then `lookup_fields` once every target module exists. Stock fields already present in Zoho are omitted.",
  "scalar_fields": [
    {
      "field_label": "Student Code",
      "api_name": "Student_Code",
      "data_type": "autonumber",
      "auto_number": {
        "prefix": "STU-",
        "start_number": "1",
        "suffix": ""
      },
      "_entity_field": "student_code"
    },
    {
      "field_label": "Student Ref",
      "api_name": "Student_Ref",
      "tooltip": {
        "name": "info_icon",
        "value": "The readable identity: STU-<term>-<application serial>, taken from the student's FIRST admission, so it says when they joined and never changes afterwards. The prefix used to be the programme they were admitted to; this school has no majors -- a student i"
      },
      "data_type": "text",
      "length": 32,
      "unique": {
        "case_sensitive": false
      },
      "_entity_field": "student_ref"
    },
    {
      "field_label": "First Name",
      "api_name": "First_Name",
      "data_type": "text",
      "length": 60,
      "system_mandatory": true,
      "_entity_field": "first_name"
    },
    {
      "field_label": "Last Name",
      "api_name": "Last_Name",
      "data_type": "text",
      "length": 60,
      "system_mandatory": true,
      "_entity_field": "last_name"
    },
    {
      "field_label": "Date of Birth",
      "api_name": "Date_Of_Birth",
      "data_type": "date",
      "_entity_field": "date_of_birth"
    },
    {
      "field_label": "Gender",
      "api_name": "Gender",
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Male",
          "actual_value": "Male",
          "sequence_number": 1
        },
        {
          "display_value": "Female",
          "actual_value": "Female",
          "sequence_number": 2
        },
        {
          "display_value": "Other",
          "actual_value": "Other",
          "sequence_number": 3
        },
        {
          "display_value": "Prefer Not To Say",
          "actual_value": "Prefer Not To Say",
          "sequence_number": 4
        }
      ],
      "_entity_field": "gender"
    },
    {
      "field_label": "Status",
      "api_name": "Status",
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Prospective",
          "actual_value": "Prospective",
          "sequence_number": 1
        },
        {
          "display_value": "Active",
          "actual_value": "Active",
          "sequence_number": 2
        },
        {
          "display_value": "On Hold",
          "actual_value": "On Hold",
          "sequence_number": 3
        },
        {
          "display_value": "Withdrawn",
          "actual_value": "Withdrawn",
          "sequence_number": 4
        },
        {
          "display_value": "Graduated",
          "actual_value": "Graduated",
          "sequence_number": 5
        },
        {
          "display_value": "Alumni",
          "actual_value": "Alumni",
          "sequence_number": 6
        }
      ],
      "system_mandatory": true,
      "default_value": "Prospective",
      "_entity_field": "status"
    },
    {
      "field_label": "Phone",
      "api_name": "Phone",
      "data_type": "phone",
      "length": 30,
      "_entity_field": "phone"
    },
    {
      "field_label": "Enrollment Date",
      "api_name": "Enrollment_Date",
      "data_type": "date",
      "_entity_field": "enrollment_date"
    },
    {
      "field_label": "Fee Total",
      "api_name": "Fee_Total",
      "tooltip": {
        "name": "info_icon",
        "value": "What the chosen courses come to. Charged per sign-up, not per course -- the admissions rows are only created once this is settled."
      },
      "data_type": "currency",
      "length": 16,
      "decimal_place": 2,
      "currency": {
        "precision": "2",
        "rounding_option": "normal"
      },
      "_entity_field": "fee_total"
    },
    {
      "field_label": "Fee Paid",
      "api_name": "Fee_Paid",
      "data_type": "currency",
      "length": 16,
      "decimal_place": 2,
      "currency": {
        "precision": "2",
        "rounding_option": "normal"
      },
      "default_value": "0",
      "_entity_field": "fee_paid"
    },
    {
      "field_label": "Payment Status",
      "api_name": "Payment_Status",
      "tooltip": {
        "name": "info_icon",
        "value": "Admissions rows are created when this reaches Paid or Waived. Before that the student has chosen courses but is not admitted to any of them."
      },
      "data_type": "picklist",
      "pick_list_values": [
        {
          "display_value": "Unpaid",
          "actual_value": "Unpaid",
          "sequence_number": 1
        },
        {
          "display_value": "Partially Paid",
          "actual_value": "Partially Paid",
          "sequence_number": 2
        },
        {
          "display_value": "Paid",
          "actual_value": "Paid",
          "sequence_number": 3
        },
        {
          "display_value": "Waived",
          "actual_value": "Waived",
          "sequence_number": 4
        },
        {
          "display_value": "Refunded",
          "actual_value": "Refunded",
          "sequence_number": 5
        }
      ],
      "system_mandatory": true,
      "default_value": "Unpaid",
      "_entity_field": "payment_status"
    },
    {
      "field_label": "Exit Date",
      "api_name": "Exit_Date",
      "data_type": "date",
      "_entity_field": "exit_date"
    },
    {
      "field_label": "Emergency Contact",
      "api_name": "Emergency_Contact_Name",
      "data_type": "text",
      "length": 120,
      "_entity_field": "emergency_contact_name"
    },
    {
      "field_label": "Emergency Contact Phone",
      "api_name": "Emergency_Contact_Phone",
      "data_type": "phone",
      "length": 30,
      "_entity_field": "emergency_contact_phone"
    },
    {
      "field_label": "Medical Notes",
      "api_name": "Medical_Notes",
      "data_type": "textarea",
      "textarea": {
        "type": "small"
      },
      "_entity_field": "medical_notes"
    }
  ],
  "lookup_fields": [
    {
      "field_label": "Household",
      "api_name": "Household",
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Contacts"
        },
        "display_label": "Students"
      },
      "system_mandatory": true,
      "_entity_field": "household"
    },
    {
      "field_label": "Signed Up For",
      "api_name": "Signed_Up_For",
      "tooltip": {
        "name": "info_icon",
        "value": "The term this student signed up for. The sign-up lives on the student rather than in a module of its own: one person signing up once, for one term, paying once."
      },
      "data_type": "lookup",
      "lookup": {
        "module": {
          "api_name": "Terms"
        },
        "display_label": "Students"
      },
      "_entity_field": "signup_term"
    }
  ],
  "relabel_stock_fields": [
    {
      "api_name": "Record_Image",
      "new_label": "Student Photo",
      "_entity_field": "photo"
    }
  ]
}
