{
  "name": "student-management-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React widget for the student-management system, embedded in Zoho CRM.",
  "scripts": {
    "sync:types": "node scripts/sync-types.mjs",
    "dev": "npm run sync:types && vite",
    "build": "npm run sync:types && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run sync:types && tsc -b --force"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
