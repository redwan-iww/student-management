{
  "name": "student-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Student-management system: one canonical schema generated into Zoho CRM metadata and TypeScript, plus the React web tabs that run inside Zoho CRM.",
  "scripts": {
    "gen": "npm run gen:zoho && npm run gen:types && npm run gen:docs",
    "gen:zoho": "node generators/gen-zoho.mjs",
    "gen:docs": "node generators/gen-docs.mjs",
    "gen:types": "node generators/gen-types.mjs",
    "verify:types": "tsc --noEmit --strict --target ES2022 --moduleResolution bundler --module ESNext build/types.ts",
    "sync:types": "node scripts/sync-types.mjs",
    "dev": "npm run sync:types && vite",
    "build": "npm run sync:types && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "npm run sync:types && tsc -b --force"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.11"
  }
}
